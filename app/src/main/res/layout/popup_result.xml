<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/popup_result"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:background="@drawable/bg_popup_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/text_first"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="덕분에 길을 잘 찾아갔어!"
            android:textSize="20sp"
            android:fontFamily="@font/pretendard_semibold"
            android:textAlignment="center"
            android:layout_marginTop="35dp"/>

        <TextView
            android:id="@+id/text_second"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앞으로도 잘 부탁해~"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_regular"
            android:textAlignment="center"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="25dp"
            android:layout_marginHorizontal="20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_hansel_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_story_stop"
                android:text="그만하기"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="#C2C4C8"
                android:layout_weight="1"
                android:layout_marginEnd="4.5dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_hansel_next_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4.5dp"
                android:layout_weight="1"
                android:background="@drawable/btn_story_next_step"
                android:fontFamily="@font/pretendard_semibold"
                android:text="다음단계"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>